{
  "name": "vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy:dev": "powershell -ExecutionPolicy Bypass -File .\\scripts\\post-deploy-powerapps.ps1 -Stage dev",
    "deploy:test": "powershell -ExecutionPolicy Bypass -File .\\scripts\\post-deploy-powerapps.ps1 -Stage test",
    "deploy:prod": "powershell -ExecutionPolicy Bypass -File .\\scripts\\post-deploy-powerapps.ps1 -Stage prod",
    "sync-deploy-config:dev": "powershell -ExecutionPolicy Bypass -File .\\scripts\\sync-deploy-config-from-powerconfig.ps1 -Stage dev",
    "sync-deploy-config:test": "powershell -ExecutionPolicy Bypass -File .\\scripts\\sync-deploy-config-from-powerconfig.ps1 -Stage test",
    "sync-deploy-config:prod": "powershell -ExecutionPolicy Bypass -File .\\scripts\\sync-deploy-config-from-powerconfig.ps1 -Stage prod"
  },
  "dependencies": {
    "@microsoft/power-apps": "^1.2.5",
    "lucide-react": "^1.43.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@microsoft/power-apps-cli": "1.0.1",
    "@microsoft/power-apps-vite": "^1.0.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
